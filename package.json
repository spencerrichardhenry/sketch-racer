{
  "name": "sketch-racer",
  "version": "0.1.0",
  "description": "Sketch a 2D level, then race it in simple 3D.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node e2e/verify.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
